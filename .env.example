# Primary Bot Credentials
DISCORD_TOKEN=your_primary_bot_token_here
CLIENT_ID=your_primary_bot_client_id_here
GUILD_ID=your_private_guild_id_here
OWNER_ID=your_discord_user_id_here

# Worker Bot Tokens (Optional)
# Add as many workers as you need. The bot discovers them automatically.
# The legacy WORKER_TOKEN (no suffix) also works for single-worker setups.
# WORKER_TOKEN=your_single_worker_token_here
WORKER_TOKEN_1=
WORKER_TOKEN_2=
# WORKER_TOKEN_3=
# WORKER_TOKEN_4=

# Lavalink Node 1 (Primary)
LAVALINK_HOST=localhost
LAVALINK_PORT=9001
LAVALINK_PASSWORD=yoursecretpassword
LAVALINK_SECURE=false

# Lavalink Node 2 (Worker - Optional)
LAVALINK_WORKER_HOST=
LAVALINK_WORKER_PORT=
LAVALINK_WORKER_PASSWORD=
LAVALINK_WORKER_SECURE=false

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password_here
DB_NAME=krayz_music
DB_SSL=false

# Spotify Developer Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# YouTube OAuth Token (Required for age-restricted/rate-limited tracks)
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Set to 'true' only when you change command definitions. Resets after deploy.
DEPLOY_COMMANDS=false
